#!/bin/bash
# This script is called in a Vim function to compile the provided root document. See vimrc.

root_file=${1%.*}
lives_in_dir=$(dirname ${root_file}.tex)
root_file_name=$(basename ${root_file}.tex)
file_to_build="${root_file}.tex"
file_to_show="${lives_in_dir}/pdfs/${root_file_name%.*}.pdf"

artifact_dirs=( 'build' 'pdfs' )
# If a latex 'build' directory does not exist, create it.
# This helps keep the directory clean of all the compiled files.
for artifact in "${artifact_dirs[@]}"; do
  if [[ ! -d "${lives_in_dir}/${artifact}" ]]; then
    mkdir -p "${lives_in_dir}/${artifact}"; mkdir_rc=$?
  fi
done

# Move the 'build' files
function move_logs {
  local latex_build_artifact_filetypes=( 'aux' 'fls' 'log' 'out' )
  for filetype in "${latex_build_artifact_filetypes[@]}"; do
    if [[ -f ${root_file}.${filetype} ]]; then
      echo "We found ${root_file}.${filetype}...Moving to build dir..."
      mv "${root_file}.${filetype}" "${lives_in_dir}/build/"; mv_rc=$?
    fi
  done

  if [[ -f ${root_file}.pdf ]]; then
    echo "We found ${root_file}.pdf...Moving to pdfs dir..."
    mv "${root_file}.pdf" "${lives_in_dir}/pdfs/"; mv_rc=?
  fi
}

# Check if a pdf of the file is already open. Zathura supports live-refreshing.
if [[ $(pgrep -f "${PDFVIEWER} ${file_to_show}") ]]; then
  echo "PDF already open. Rebuilding..."
  pdflatex "${file_to_build}"
  move_logs
else
  echo "PDF not already open. Building..."
  pdflatex "${file_to_build}"
  move_logs
  echo "Opening PDF..."
  "${PDFVIEWER}" "${file_to_show}" &
fi
